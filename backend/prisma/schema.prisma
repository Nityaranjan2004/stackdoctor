datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id           String       @id @default(uuid())
  name         String
  path         String
  gitUrl       String?
  status       String       @default("idle") // idle, scanning, completed, failed
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  stacks       Stack[]
  dependencies Dependency[]
  diagnostics  Diagnostic[]
}

model Stack {
  id         String   @id @default(uuid())
  name       String
  version    String?
  category   String // Frontend, Backend, Database, CLI, Build, Language, etc.
  confidence Float    @default(1.0)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, name])
}

model Dependency {
  id        String   @id @default(uuid())
  name      String
  version   String
  type      String // npm, pip, maven, cargo, docker, etc.
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, type, name])
}

model Diagnostic {
  id          String   @id @default(uuid())
  title       String
  description String
  severity    String // info, warning, error
  file        String?
  line        Int?
  ruleId      String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
